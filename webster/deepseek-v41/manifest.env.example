# Fixed checkpoint identity. This file documents fields only and is never sourced
# as a live manifest. pin-runtime.py and run-weka.sh --pin populate execution-time
# values in the mode-0600 manifest.env under a run root.
CHECKPOINT_REPO=deepseek-ai/DeepSeek-V4.1-Flash
CHECKPOINT_REVISION=dba1be0a40aa45a94ad051997016db3960a90277
CHECKPOINT_SHARDS=48
CHECKPOINT_WEIGHT_BYTES=510286023000

# Required execution-time pins. Preflight rejects empty values in phases that use
# them; floating branches, tags, and dataset aliases are not accepted.
VLLM_COMMIT=
VLLM_BASE_IMAGE_DIGEST=
VLLM_IMAGE_ID=
VLLM_IMAGE_TAR_SHA256=
AIPERF_COMMIT=
WEKA_REPOSITORY=
WEKA_REVISION=
